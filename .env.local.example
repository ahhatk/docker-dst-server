# Copy this file to .env.local and fill in your cluster token from
# https://accounts.klei.com/account/game/servers
# Get the token in-game: account -> GAMES -> Don't Starve Together Servers -> ADD NEW SERVER.
# pds-g^..., a single line, no trailing newline required (the entrypoint normalizes it).
DST_CLUSTER_TOKEN=pds-g^REPLACE-WITH-REAL-TOKEN
